# Optional: override the public Google Calendar API key used by the
# "Upcoming Events" section.
#
# By default the component uses the same public key already shipped on
# rlbot.org (see src/components/UpcomingEvents.astro), so you only need this if
# you want to use a different key. The key is inlined into the built JavaScript,
# so keep the HTTP referrer restrictions on it. `.env` is gitignored.
PUBLIC_GOOGLE_CALENDAR_API_KEY=
