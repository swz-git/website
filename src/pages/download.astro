---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    discordUrl,
    v4DownloadUrl,
    v5DownloadUrl,
    v5OverviewUrl,
    v5RLBotServerLinuxUrl,
    v5RLBotGuiLinuxUrl,
} from "../consts";
---

<BaseLayout
    title="RLBot | Download"
    description="Download RLBot v5 for Windows, or use it on Linux with Rocket League under Proton or the Epic Games Store."
>
    <section class="download-hero">
        <h1>Download RLBot</h1>
    </section>

    <section class="section os-switch" aria-label="Download options">
        <div class="os-toggle">
            <a class="os-tab" href="#windows">Windows</a>
            <a class="os-tab" href="#linux">Linux</a>
        </div>

        <div class="os-panel" id="windows">
            <div class="card download-card version-card recommended">
                <div class="version-head">
                    <h3>RLBot v5</h3>
                    <span class="pill">Latest</span>
                </div>
                <p>
                    The latest version of RLBot. A rewrite of RLBot v4 with many
                    improvements including much better performance. <a
                    href={v5OverviewUrl}>See v4 vs v5
                    </a>
                </p>
                <div class="version-actions">
                    <a class="button" target="_blank" href={v5DownloadUrl}>
                        Download
                    </a>

                </div>
            </div>
            <div class="card download-card version-card">
                <div class="version-head">
                    <h3>RLBot v4</h3>
                    <span class="pill">Legacy</span>
                </div>
                <p>
                    The last generation of RLBot. Slower and not actively
                    maintained anymore. This version still has some features
                    that v5 haven't yet implemented, such as story mode. RLBot
                    v4 also has more legacy bots compared to v5.
                </p>
                <div class="version-actions">
                    <a class="button" target="_blank" href={v4DownloadUrl}>
                        Download
                    </a>
                </div>
            </div>
        </div>

        <div class="os-panel" id="linux">
            <div class="card download-card version-card recommended">
                <div class="version-head">
                    <h3>RLBot v5</h3>
                    <span class="pill">Latest</span>
                </div>
                <p>
                    The latest version of RLBot. A rewrite of RLBot v4 with many
                    improvements including much better performance. This version
                    also brings way better linux support.
                </p>
                <div class="version-actions">
                    <a class="button" target="_blank" href={v5RLBotServerLinuxUrl}>
                        Download <pre>RLBotServer</pre>
                    </a>
                    <a class="button" target="_blank" href={v5RLBotGuiLinuxUrl}>
                        Download <pre>rlbotgui</pre>
                    </a>
                </div>
                <p style="color: sandybrown">
                    Note that we are still working on a {}
                    <a href="https://github.com/VirxEC/rlbot-flatpak">proper {}
                    launcher package</a> for linux. Until its done, you can use
                    RLBot v5 by launching the server and gui binaries yourself.
                    Feel free to <a href={discordUrl}>ask in the  Discord</a> {}
                    if you get stuck.
                </p>
            </div>
            <p class="legacy-note">
                RLBot v4 only supports the old native Steam build on linux, not Proton
                or Epic. Using v4 on linux is strongly advised against.
            </p>
        </div>
    </section>
</BaseLayout>

<style>
    .download-hero {
        max-width: 52rem;
    }

    .download-hero h1 {
        margin: 0;
        font-size: clamp(2.75rem, 7vw, 4.5rem);
    }

    .os-toggle {
        display: inline-flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid var(--surface-border);
        border-radius: 999px;
        background: var(--surface);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .os-tab {
        padding: 6px 22px;
        border-radius: 999px;
        color: var(--fg-muted);
        font-weight: 600;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .os-tab:hover,
    .os-tab:focus-visible {
        color: var(--fg);
    }

    /* Highlight the active tab, defaulting to Windows when no hash is set. */
    .os-switch:not(:has(.os-panel:target)) .os-tab[href="#windows"],
    .os-switch:has(#windows:target) .os-tab[href="#windows"],
    .os-switch:has(#linux:target) .os-tab[href="#linux"] {
        background: var(--accent);
        color: var(--accent-contrast);
    }

    .os-panel {
        display: none;
        max-width: 42rem;
        margin-top: 24px;
        scroll-margin-top: 2rem;
    }

    /* Show the targeted panel, defaulting to Windows when no hash is set. */
    .os-switch:not(:has(.os-panel:target)) #windows,
    .os-panel:target {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .download-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .download-card h3 {
        margin: 0;
    }

    .version-card.recommended {
        border-color: rgba(116, 192, 107, 0.5);
    }

    .version-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .version-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
    }

    .pill {
        padding: 2px 10px;
        border: 1px solid var(--accent);
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-hover);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .legacy-note {
        margin: 0;
    }
</style>
