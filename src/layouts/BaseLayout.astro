---
import logoUrl from "../../assets/logos/rlbot.svg?url";
import discordIcon from "../../assets/icons/discord.svg?url";
import twitterIcon from "../../assets/icons/twitter.svg?url";
import youtubeIcon from "../../assets/icons/youtube.svg?url";
import twitchIcon from "../../assets/icons/twitch.svg?url";
import redditIcon from "../../assets/icons/reddit.svg?url";
import {
    defaultDescription,
    defaultTitle,
    discordUrl,
    githubUrl,
    wikiUrl,
} from "../consts";

interface Props {
    title?: string;
    description?: string;
}

const { title = defaultTitle, description = defaultDescription } = Astro.props;

const nav = [
    { name: "Download", href: "/download" },
    { name: "Wiki", href: wikiUrl },
    { name: "Discord", href: discordUrl },
    { name: "GitHub", href: githubUrl },
];

const socials = [
    { name: "Discord", url: discordUrl, icon: discordIcon },
    {
        name: "Twitter",
        url: "https://twitter.com/RLBotOfficial",
        icon: twitterIcon,
    },
    {
        name: "YouTube",
        url: "https://www.youtube.com/c/RLBotOfficial",
        icon: youtubeIcon,
    },
    {
        name: "Twitch",
        url: "https://www.twitch.tv/rlbotofficial",
        icon: twitchIcon,
    },
    {
        name: "Reddit",
        url: "https://www.reddit.com/r/RocketLeagueBots/",
        icon: redditIcon,
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href={logoUrl} />
    </head>

    <body>
        <canvas class="circuit-background" aria-hidden="true"></canvas>
        <header class="site-header">
            <a class="brand shadow" href="/">
                <img src={logoUrl} alt="" width="42" height="42" />
                <span>RLBot</span>
            </a>
            <nav class="site-nav desktop-nav shadow" aria-label="Primary">
                {nav.map((item) => <a href={item.href}>{item.name}</a>)}
            </nav>
            <details class="mobile-nav">
                <summary class="nav-toggle" aria-label="Navigation">
                    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 6h18M3 12h18M3 18h18" />
                    </svg>
                </summary>
                <nav class="site-nav shadow" aria-label="Primary">
                    {nav.map((item) => <a href={item.href}>{item.name}</a>)}
                </nav>
            </details>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <div class="social-links">
                {socials.map((social) => (
                    <a
                        href={social.url}
                        title={social.name}
                        aria-label={social.name}
                    >
                        <img
                            src={social.icon}
                            alt={social.name}
                            width="32"
                            height="32"
                        />
                    </a>
                ))}
            </div>
            <p>
                RLBot is a community of bot makers and a framework for offline
                bots
            </p>
        </footer>
        <script src="../scripts/circuit-background.js"></script>
    </body>
</html>

<style is:global>
    /* Base styles shared by every page: font, design tokens, reset and
       typography, plus the few primitives (card, button, shadow) that more than
       one page or component renders. Everything narrower lives next to its
       markup. */

    /* Prefer an installed copy of Inter; only download the webfont if it is not
       available locally. No JavaScript required. Do not preload this file, or the
       download would happen even when Inter is already installed. */
    @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src:
            local("Inter"),
            local("Inter Variable"),
            url("../../assets/fonts/Inter.woff2") format("woff2");
    }

    :root {
        --bg: #010201;
        --fg: #ffffff;
        --fg-muted: #d7d7d7;
        --accent: #74c06b;
        --accent-hover: #8ad181;
        --accent-contrast: #0d1f0c;
        --accent-soft: rgba(116, 192, 107, 0.22);
        --warning: #e6b350;
        --surface: rgba(16, 19, 16, 0.82);
        --surface-border: rgba(255, 255, 255, 0.16);
        --max-width: 80rem;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            "Segoe UI",
            sans-serif;
        line-height: 1.55;
    }

    a {
        color: var(--fg-muted);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    a:hover {
        color: var(--fg);
    }

    h1 {
        line-height: 1;
    }

    h2 {
        margin: 0;
        font-size: 2rem;
    }

    p {
        color: var(--fg-muted);
    }

    p a {
        color: lightblue;
        text-decoration: underline;
        text-underline-offset: 0.15rem;
    }

    a pre {
        display: inline;
    }

    /* View transitions (native cross-document, no client-side router) */

    @view-transition {
        navigation: auto;
    }

    @keyframes move-out {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    @keyframes move-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    ::view-transition-old(root) {
        animation: 0.4s ease both move-out;
    }

    ::view-transition-new(root) {
        animation: 0.4s ease both move-in;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
            animation: none !important;
        }
    }

    /* Shared primitives */

    * {
        text-shadow: initial;
    }

    .shadow,
    .shadow > * {
        text-shadow: 0 0 0.5rem #000;
    }

    .secondary-link {
        font-size: 0.9em;
    }

    .card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 20px;
        border: 1px solid var(--surface-border);
        border-radius: 12px;
        background: var(--surface);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        text-decoration: none;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease;
    }

    .card img {
        flex-shrink: 0;
        object-fit: contain;
    }

    .card h3 {
        margin: 0 0 2px;
        font-size: 1.15rem;
    }

    .card p {
        margin: 0;
        font-size: 1rem;
    }

    a.card:hover {
        border-color: var(--accent);
        background: var(--accent-soft);
    }

    a.button {
        display: inline-block;
        padding: 10px 26px;
        border-radius: 0.5rem;
        background: var(--accent);
        color: var(--accent-contrast);
        font-size: 1.15rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }

    a.button:hover {
        background: var(--accent-hover);
    }

    a.button.secondary {
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.1);
        color: var(--fg);
    }

    a.button.secondary:hover {
        background: rgba(255, 255, 255, 0.18);
    }

    @media (max-width: 900px) {
        body {
            font-size: 17px;
        }
    }
</style>

<style>
    /* Page shell: header, footer and the main column every page slots into. */

    .circuit-background {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        display: block;
        width: 100%;
        pointer-events: none;
    }

    /* Shared across pages, so give the header and footer their own transition
       group and let them morph in place instead of cross-fading with the page. */
    .site-header {
        container-type: inline-size;
        position: relative;
        z-index: 1;
        view-transition-name: site-header;
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 28px 24px 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .brand {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .brand img {
        display: block;
    }

    .site-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 28px;
        font-size: 1.05rem;
    }

    .site-nav a {
        width: max-content;
        flex-shrink: 0;
    }

    .mobile-nav {
        display: none;
        flex-shrink: 0;
    }

    .nav-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 0.5rem;
        background: transparent;
        color: var(--fg);
        cursor: pointer;
        list-style: none;
    }

    .nav-toggle::-webkit-details-marker {
        display: none;
    }

    .nav-toggle:hover {
        color: var(--accent-hover);
    }

    .nav-toggle:focus-visible,
    .site-nav a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
    }

    .nav-toggle svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
    }

    .mobile-nav .site-nav {
        position: absolute;
        top: calc(100% + 12px);
        right: 24px;
        flex-direction: column;
        align-items: stretch;
        row-gap: 0;
        padding: 8px;
        border: 1px solid var(--surface-border);
        border-radius: 12px;
        background: var(--bg);
    }

    .mobile-nav .site-nav a {
        width: auto;
        padding: 10px 16px;
    }

    /* Room for the brand, four links and their gaps, with a little allowance
       for fallback fonts. Query the header's usable width, not the viewport. */
    @container (max-width: 32rem) {
        .desktop-nav {
            display: none;
        }

        .mobile-nav {
            display: block;
        }
    }

    main {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 72px;
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 48px 24px;
    }

    .site-footer {
        view-transition-name: site-footer;
        flex-shrink: 0;
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px;
        text-align: center;
        color: #9a9a9a;
        font-size: 0.85rem;
    }

    .site-footer p {
        margin: 0;
    }

    .social-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 28px;
        margin-bottom: 18px;
    }

    .social-links a {
        display: inline-flex;
    }

    .social-links img {
        display: block;
        width: 30px;
        height: 30px;
        object-fit: contain;
        opacity: 0.7;
        transition: opacity 0.15s ease;
    }

    .social-links a:hover img {
        opacity: 1;
    }

    @media (max-width: 900px) {
        main {
            padding: 2.5rem 1.5rem;
        }
    }
</style>
